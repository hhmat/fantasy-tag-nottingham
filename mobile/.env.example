# Supabase project settings — safe to ship in the app bundle (anon key is
# protected by Row Level Security). Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# OAuth redirect handled via the app scheme: fantasytag://auth/callback
